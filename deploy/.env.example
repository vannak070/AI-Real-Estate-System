# Production settings — copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Replace 203.0.113.10 below with your server's IP address.

# ─── Addresses ─────────────────────────────────────────
# No domain yet: the websites are http://<IP> (customer) and http://<IP>:8080 (back office).
CLIENT_SITE=:80
ADMIN_SITE=:8080
CLIENT_URL=http://203.0.113.10
PUBLIC_SITE_URL=http://203.0.113.10
# Every address the websites are opened on (the API refuses others).
CORS_ORIGINS=http://203.0.113.10,http://203.0.113.10:8080
# Plain HTTP → must be false. Set true after switching to a domain with HTTPS.
COOKIE_SECURE=false

# With a domain later (see deploy/README.md → "Adding a domain"):
# CLIENT_SITE=www.example.com
# ADMIN_SITE=admin.example.com
# CLIENT_URL=https://www.example.com
# PUBLIC_SITE_URL=https://www.example.com
# CORS_ORIGINS=https://www.example.com,https://admin.example.com
# COOKIE_SECURE=true
# PUBLIC_API_URL=https://www.example.com        ← switches the Telegram bot to a webhook

# ─── Secrets (generate each with: openssl rand -hex 24) ─
# Letters and digits only — it goes inside the database address.
POSTGRES_PASSWORD=

# ─── AI + Telegram ────────────────────────────────────
ANTHROPIC_API_KEY=
# Only ONE machine may run a bot token. Once this server runs it, remove the token from your
# laptop's .env (or give the laptop a separate test bot) — two copies fight over the messages.
TELEGRAM_BOT_TOKEN=

# ─── Inbox ───────────────────────────────────────────
INBOX_AUTO_HANDBACK_MINUTES=30
INBOX_IDLE_RELEASE_HOURS=12
