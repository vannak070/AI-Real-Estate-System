# ─── API ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# ─── Database ──────────────────────────────────────────
# One Postgres while it's a monolith. After you extract a module,
# give that service its OWN DATABASE_URL and drop its tables here.
# Runs in Docker via docker-compose.yml (`docker compose up -d postgres`) —
# on :5435 because :5432/:5433/:5434 are already used by other projects on
# this machine.
DATABASE_URL=postgresql://era:era@localhost:5435/era?schema=public

# ─── CORS ───────────────────────────────────────────────
# Fixed allowlist of browser origins allowed to call the API with credentials
# (the session cookie). In development the API ALSO accepts any private-LAN
# origin (10.x/172.16-31.x/192.168.x) on ports 5173/5174 — see platform/cors.ts
# — so accessing the SPAs from another device on your network just works
# without editing this. This list is what still applies in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Event bus ─────────────────────────────────────────
# inprocess = modular monolith (default).
# nats      = after the first module is extracted (wire NatsEventBus first).
EVENT_BUS=inprocess
NATS_URL=nats://localhost:4222

# ─── Frontends ─────────────────────────────────────────
# apps/client (customer website, :5173) and apps/admin (back office, :5174)
# are separate Vite apps, each with `server.host: true` (LAN-reachable; Vite
# prints the Network URL to use from another device).
#
# Leave VITE_CLIENT_URL / VITE_API_BASE_URL UNSET for normal dev — the code
# falls back to `http://${window.location.hostname}:<port>`, which resolves
# correctly whether you open the app via localhost or a LAN IP. Only set them
# to pin a fixed cross-origin value (e.g. a real domain in production).
# VITE_API_BASE_URL=http://localhost:4000
# VITE_CLIENT_URL=http://localhost:5173
