// New in Phase 0 #1 — reconciled with packages/mock-data/src/erp/types.ts.
// NumberSequence backs Phase 0 #4 (atomic doc numbering) — bump `nextNumber`
// inside a transaction with `SELECT ... FOR UPDATE` semantics (Prisma:
// `db.$transaction` + a conditional update), never read-then-write outside one.

model CompanyProfile {
  /// singleton row
  id        String   @id @default("default")
  name      String
  legalName String?
  address   String?
  phone     String?
  email     String?
  taxId     String?
  currency  String   @default("USD")
  timezone  String   @default("Asia/Phnom_Penh")
  locale    String   @default("en-KH")
  updatedAt DateTime @updatedAt

  @@map("settings_company_profile")
}

model NumberSequence {
  id     String @id @default(cuid())
  /// human label, e.g. "Reservation", "Sale Agreement" — NOT the lookup key
  doc    String @unique
  /// the lookup key services call nextNumber() with — "QT","RSV","SPA","INV","PAY","RCP",...
  prefix String @unique
  nextNumber Int @default(1)
  padding    Int @default(4)

  @@map("settings_number_sequences")
}

model TaxRate {
  id        String  @id @default(cuid())
  name      String
  ratePct   Float
  isDefault Boolean @default(false)

  @@map("settings_tax_rates")
}

/// CMS content for the public site's About page (apps/client's AboutPage.tsx, "Overview" tab) —
/// previously hardcoded strings baked into that component, editable from nowhere. Singleton row,
/// same pattern as CompanyProfile. The "Contact" tab on the client stays static/out of scope —
/// it's not part of what apps/admin's ManageAboutPage.tsx was ever meant to manage.
model AboutPageContent {
  id           String   @id @default("default")
  pageTitle    String   @default("About ERA Cambodia")
  subtitle     String?
  paragraph1   String?
  paragraph2   String?
  mission      String?
  values       String[] @default([])
  /// free-text marketing figures (e.g. "1,247+", "94.5%") — not always plain numbers
  statProjects String?
  statLeads    String?
  statAccuracy String?
  statTeamSize String?
  updatedAt    DateTime @updatedAt

  @@map("settings_about_content")
}

model AboutMilestone {
  id          String @id @default(cuid())
  year        String
  title       String
  description String
  /// display order, lowest first — not creation order, since a re-ordered timeline is a real edit
  order       Int    @default(0)

  @@map("settings_about_milestones")
}

model AboutTeamMember {
  id       String  @id @default(cuid())
  name     String
  position String
  bio      String?
  /// relative path under /uploads, same convention as Project.imageUrls — single headshot, like User.photoUrl
  photoUrl String?
  /// the one CEO/leadership card gets the large bio layout; everyone else renders in the grid
  isLeader Boolean @default(false)
  order    Int     @default(0)

  @@map("settings_about_team_members")
}

model AboutAward {
  id           String  @id @default(cuid())
  year         String
  title        String
  organization String
  description  String?
  order        Int     @default(0)

  @@map("settings_about_awards")
}
