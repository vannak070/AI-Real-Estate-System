// Chat-app conversations (Telegram today; Messenger/WhatsApp later) handled by the AI assistant.
// Unlike the website chat — where the browser holds the history — these platforms only ever send
// the newest message, so the server keeps each conversation here.

enum MessagingRole {
  USER
  /// The AI assistant.
  ASSISTANT
  /// An ERA staff member replying from the admin Inbox (MessagingMessage.agentId).
  AGENT
}

/// Who answers the customer right now.
enum MessagingMode {
  AI
  /// A staff member took the conversation over in the Inbox — the AI stays silent until handed back.
  AGENT
}

model MessagingConversation {
  id             String             @id @default(cuid())
  /// A marketing channel key (marketing_channels.key), e.g. "TELEGRAM" — also the lead's source.
  channel        String
  /// The platform's own chat id (Telegram chat.id).
  externalChatId String
  /// As the platform reports it — unverified, not necessarily the customer's real name.
  displayName    String?
  username       String?
  /// The CRM lead this conversation created (crm_leads.id, no FK — module rule). Later contact
  /// corrections update that lead instead of creating a new one.
  leadId         String?
  /// From a campaign deep link (t.me/<bot>?start=<code>) — attributes the lead to that campaign.
  campaignCode   String?
  mode           MessagingMode      @default(AI)
  /// identity_users.id of the staff member who took over (no FK — module rule). null in AI mode.
  handledById    String?
  handledSince   DateTime?
  /// The AI's request_agent tool asked for a person (reason in needsAgentReason). Cleared on takeover.
  needsAgent       Boolean          @default(false)
  needsAgentReason String?
  /// Customer messages not yet opened in the Inbox (reset when a staff member opens the conversation).
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  messages       MessagingMessage[]

  @@unique([channel, externalChatId])
  @@index([lastMessageAt])
  @@map("messaging_conversations")
}

model MessagingMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessagingRole
  text           String
  /// identity_users.id for AGENT messages (no FK — module rule).
  agentId        String?
  /// The platform's message id for inbound messages — unique per conversation, so a redelivered
  /// update (webhook retry) is recognised and skipped instead of answered twice.
  externalId     String?
  createdAt      DateTime              @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@map("messaging_messages")
}

/// A staff member's Telegram chat with the bot, for staff alerts (a customer asks for a person, a
/// customer writes to a chat they're handling, a new lead is assigned to them). Linked from the
/// admin Inbox: a one-time code opens t.me/<bot>?start=staff_<code>, and the bot ties that chat to
/// the user. One row per user.
model MessagingStaffAlertLink {
  /// identity_users.id (no FK — module rule).
  userId            String    @id
  /// Telegram chat.id — null until the code is used.
  chatId            String?
  /// As Telegram reports the person who linked it.
  telegramName      String?
  linkedAt          DateTime?
  /// One-time link code (15 min). Cleared once used.
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?
  /// The back office's address as the staff member opened it — alert buttons link there.
  adminUrl          String?
  createdAt         DateTime  @default(now())

  @@index([chatId])
  @@map("messaging_staff_alert_links")
}

/// Alerts already sent for an event, keyed e.g. "lead:<leadId>" — a redelivered event (NATS
/// retry) is recognised and not alerted twice.
model MessagingStaffAlertSent {
  key       String   @id
  createdAt DateTime @default(now())

  @@map("messaging_staff_alerts_sent")
}
